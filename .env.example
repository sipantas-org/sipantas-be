# Copy this file to .env and adjust the values for your local setup.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sipantas_db?schema=public"

JWT_SECRET="dev-only-change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

PORT=3000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"
