enum DurationUnit {
  Hari
  Bulan
  Tahun
}

model SurveyLostDetail {
  surveyLostDetailId   Int          @id @default(autoincrement())
  surveyId Int
  lossAssessmentId Int
  totalUnit Int
  unitPrice Decimal @db.Decimal(15, 2)
  duration Int
  durationUnit DurationUnit
  description String

  LossAssessment LossAssessment @relation(fields: [lossAssessmentId], references: [lossAssessmentId])

   @@map("SurveyLostDetail")
}