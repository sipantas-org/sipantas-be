enum SurveyorStatus {
  Pending
  Active
  Inactive
  Rejected
}

model UserSurveyor {
  surveyorId Int            @id @default(autoincrement())
  NIP         String         @unique
  Nama        String
  phoneNumber    String
  Email       String         @unique
  Password    String
  Status      SurveyorStatus
  provinceId String
  regencyId     String
  lastLogin  DateTime?      @db.Timestamptz
  createdAt  DateTime       @default(now()) @db.Timestamptz
  updatedAt  DateTime       @updatedAt @db.Timestamptz

  loginHistories    LoginHistory[]
  approvals         ApprovalUser[]
  activityHistories ActivityHistory[]

  @@map("UserSurveyor")
}
