enum DamageLevel {
  TMK @map("Tidak Masuk Kategori")
  Ringan
  Sedang
  Berat
}

enum SurveyStatus {
  Pending
  OnComplain @map("On Complain")
  OnVerification @map("On Verification")
  OnBudgeting @map("On Budgeting")
  Completed
}

enum Authority {
  Pusat
  Provinsi
  KabupatenKota @map("Kabupaten / Kota")
  MasyarakatSwasta @map("Masyarakat / Swasta")
}

model Survey {
  surveyId   Int          @id @default(autoincrement())
  disasterId Int
  disaster   Disaster?    @relation(fields: [disasterId], references: [disasterId], onDelete: SetNull)

  sectorId   Int
  surveyStatus SurveyStatus

  surveyorId Int?
  surveyor   UserSurveyor? @relation(fields: [surveyorId], references: [surveyorId], onDelete: SetNull)

  provinceId        String?               @db.VarChar(20)
  province          MasterAreaProvince? @relation(fields: [provinceId], references: [id], onDelete: SetNull)

  regencyId         String?              @db.VarChar(20)  
  regency           MasterAreaRegency? @relation(fields: [regencyId], references: [id], onDelete: SetNull)

  districtId        String?               @db.VarChar(20)
  district          MasterAreaDistrict? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  villageId         String?              @db.VarChar(20)
  village           MasterAreaVillage? @relation(fields: [villageId], references: [id], onDelete: SetNull)
  
  addressDetail String
  authority Authority
  nik String
  assetName String
  latitude String
  longitude String
  damageLevel DamageLevel
  volume String
  volumeUnit String
  volumeUnitOther String
  totalPriceUnit Decimal @db.Decimal(15, 2)
  totalPriceFurniture Decimal @db.Decimal(15, 2)
  totalScore Decimal @db.Decimal(15, 2)
  sourceOfBudgetting String?
  surveyFolderPath String

  files     SurveyFileDetail[]
  surveyComplain     SurveyComplain[]

  createdAt        DateTime             @default(now()) @db.Timestamptz
  updatedAt        DateTime             @updatedAt @db.Timestamptz

  @@map("Survey")
}