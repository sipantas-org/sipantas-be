enum PartStatus {
  Active
  Inactive
}

model Housing_Assessment_Part {
  housingAssessmentPartId Int      @id @default(autoincrement())
  partName                  String @unique
  partStatus            PartStatus

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  housingDamageAssessments Housing_Damage_Assessment[]

   @@map("Housing_Assessment_Part")
}