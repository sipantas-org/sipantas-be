enum AdminStatus {
  Active
  Inactive
}

enum AdminRole {
  Administrator
  Monitoring
  Surveyor
}

model UserAdmin {
  adminId   Int         @id @default(autoincrement())
  NIP        String      @unique
  Nama       String
  phoneNumber   String
  Email      String      @unique
  Password   String
  Status     AdminStatus
  Role       AdminRole
  lastLogin DateTime?   @db.Timestamptz
  createdAt DateTime    @default(now()) @db.Timestamptz
  updatedAt DateTime    @updatedAt @db.Timestamptz

  loginHistories    LoginHistory[]
  approvals         ApprovalUser[]
  activityHistories ActivityHistory[]

  @@map("UserAdmin")
}
