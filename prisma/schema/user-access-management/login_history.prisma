enum LoginStatus {
  Success
  Failed
}

model LoginHistory {
  ID_Login     Int         @id @default(autoincrement())
  ID_User      Int?
  ID_Admin     Int?
  IP_Address   String
  Login_At     DateTime    @default(now()) @db.Timestamptz
  Device_Info  String?
  Status_Login LoginStatus

  user  UserSurveyor? @relation(fields: [ID_User], references: [ID_Surveyor])
  admin UserAdmin?    @relation(fields: [ID_Admin], references: [ID_Admin])

  @@map("Login_History")
}
