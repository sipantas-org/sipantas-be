enum DisasterStatus {
  Active
  On_Budgeting
  Completed
}

model Disaster {
  ID_Disaster       Int            @id @default(autoincrement())
  Disaster_Code     String @unique @db.VarChar(20)
  Disaster_Name     String
  Disaster_Category String
  Description       String?
  Status            DisasterStatus
  Created_At DateTime @default(now()) @db.Timestamptz
  Updated_At DateTime @updatedAt @db.Timestamptz

  @@map("Disaster")
}




